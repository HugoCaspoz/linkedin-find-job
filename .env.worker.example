# Entorno del worker de scraping (npm run scrape:prod).
#
# Separado de .env a propósito: el worker escribe en la base de datos que sirve
# a los usuarios, mientras que .env apunta al Postgres local de desarrollo.
# Tenerlos en el mismo fichero obliga a comentar y descomentar líneas, que es
# justo como se acaba indexando en la base equivocada.
#
# Usa la URL PÚBLICA de Railway (DATABASE_PUBLIC_URL en las variables del
# servicio Postgres): la DATABASE_URL normal es *.railway.internal y solo
# resuelve dentro de Railway.
DATABASE_URL="postgresql://user:password@host.proxy.rlwy.net:PORT/railway"
DIRECT_URL="postgresql://user:password@host.proxy.rlwy.net:PORT/railway"
