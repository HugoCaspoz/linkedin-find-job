# Postgres. Para desarrollo local: `docker compose up -d` y usa esta URL tal cual.
DATABASE_URL="postgresql://link:link@localhost:5432/link?schema=public"
# Conexión sin pooler, solo la usan las migraciones. En Neon/Supabase/PgBouncer
# es una URL distinta a DATABASE_URL; en local es la misma.
DIRECT_URL="postgresql://link:link@localhost:5432/link?schema=public"

# Genera uno real: openssl rand -base64 32
AUTH_SECRET=""
# En producción, la URL pública de la app (https://tu-dominio.com)
AUTH_URL="http://localhost:3000"

ANTHROPIC_API_KEY=""

ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Solo si vas a disparar el worker por HTTP (POST /api/cron/scrape).
# Mínimo 16 caracteres. Con `npm run scrape` no hace falta.
CRON_SECRET=""
